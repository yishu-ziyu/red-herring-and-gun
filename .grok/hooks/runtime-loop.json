{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_WORKSPACE_ROOT}/runtime/bin/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_WORKSPACE_ROOT}/runtime/bin/precompact_remind.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_WORKSPACE_ROOT}/runtime/bin/stop_gate.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
