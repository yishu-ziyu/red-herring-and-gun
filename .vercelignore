# Vercel 发布忽略清单（仓库根部署用）
# 根 vercel.json 的 buildCommand 需要 packages/core 与 mvp/src，
# 其余一律不上传。缺失此文件时 CLI 会连带上传 docs/ out/ .data/ 等数百 MB。

# 依赖
node_modules
**/node_modules
**/.pnpm-store

# 构建产物
dist
dist-a
dist-b
**/dist

# 证据与文档归档（175M，不属于部署产物）
docs
out
outputs
exports
**/*.zip
**/*.webm
**/*.gif

# 本地数据与研究克隆
.data
mvp/server
Chinese_Rumor_Dataset
vendor
tmp-apodex-study
.context
.ship
.grok
.claude
.agents
.cursor
.omo
.statamcp
.agent-memory
mvp/.agent-memory
.playwright-mcp

# 截图与杂项
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
!mvp/public/logo.png
!mvp/public/**/*.png
.DS_Store
**/.DS_Store
*.log

# 密钥
.env
.env.*
!.env.example
!.env.local.example

# 版本控制
.git
.gitignore
