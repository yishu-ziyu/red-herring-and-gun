# Main model: MiniMax (Anthropic-compatible endpoint).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_M27_MIN_MAX_TOKENS=4096
# MiniMax-M3 remains available as an explicit high-depth override. When used,
# adaptive thinking counts toward its recommended 128K output budget.
# MINIMAX_M3_MAX_TOKENS=131072
# MINIMAX_M3_PROVIDER_TIMEOUT_MS=600000
# Default follows local AI组件工作流 MiniMax Anthropic-compatible examples. Set to bearer only for Bearer-auth keys.
MINIMAX_AUTH_HEADER=x-api-key

# StepFun: image reading, and fallback when MiniMax fails.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-2-mini
# StepFun 3.7 Flash is a slower reasoning model. Keep reasoning short and give it its own timeout.
STEPFUN_3_7_REASONING_EFFORT=low
STEPFUN_3_7_PROVIDER_TIMEOUT_MS=135000
STEPFUN_3_7_MIN_MAX_TOKENS=4096

# Only minimax and stepfun are recognized; other names are ignored.
ORCHESTRATE_TEXT_PROVIDER_ORDER=minimax,stepfun
ORCHESTRATE_PROVIDER_TIMEOUT_MS=25000
ORCHESTRATE_TOTAL_TIMEOUT_MS=210000

# Search engines (server-side). Default set: MiniMax and StepFun search (keys above),
# Exa, Baidu Qianfan, and a local open-webSearch sidecar; each runs only when its key/URL is set.
EXA_API_KEY=
# Baidu Qianfan web search: free 1,500 calls/month, then paid per call.
QIANFAN_API_KEY=
# Qianfan searches only these sites (comma-separated, max 100; subdomains match). Empty = built-in
# authoritative list. Optional recency: week, month, semiyear, year.
QIANFAN_SITES=
QIANFAN_RECENCY=
# Local open-webSearch (`npx open-websearch@latest serve`, default port 3210). Scrapes Bing/Baidu
# result pages, so it can be blocked at any time; failing engines are skipped for a while.
OPEN_WEBSEARCH_URL=
OPEN_WEBSEARCH_ENGINES=bing,baidu
# Queries per part per engine (default 2). StepFun search concurrency per process (default 4, max 8).
SEARCH_QUERIES_PER_ATOM=2
STEPFUN_SEARCH_MAX_CONCURRENCY=4
# Optional engines, used only when named here AND their key is set, e.g.
# SEARCH_PROVIDERS=minimax_search,stepfun_search,exa_search,qianfan_search,open_websearch,tavily_search
SEARCH_PROVIDERS=
QIHOO_360_API_KEY=
SEARCH360_REF_PROM=aiso-pro
ANYSEARCH_API_KEY=
METASO_API_KEY=
TAVILY_API_KEY=

# Signs the guest quota cookie. Required in production (16+ characters).
# The old name AIPING_SESSION_SECRET is still read when SESSION_SECRET is not set.
SESSION_SECRET=
