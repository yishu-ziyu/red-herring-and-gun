{
  "name": "red-herring-and-gun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "eval": "cd server && npx tsx eval/run.ts",
    "eval:gate": "cd server && npx tsx eval/run.ts --gate eval/baseline.json",
    "e2e": "node scripts/e2e/golden-path.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@vitejs/plugin-react": "latest",
    "@xyflow/react": "^12.10.2",
    "antd": "^6.5.3",
    "framer-motion": "^12.40.0",
    "generative-loaders": "^0.1.1",
    "react": "latest",
    "react-dom": "latest",
    "react-resizable-panels": "^4.12.2",
    "typebox": "^1.3.7",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.58.2"
  }
}
