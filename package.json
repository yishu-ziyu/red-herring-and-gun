{
  "name": "rhg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --prefix apps --",
    "build": "npm run build --prefix apps && npm run build --prefix apps/server",
    "dev:web": "npm run dev:web --prefix apps",
    "dev:server": "npm run dev --prefix apps/server",
    "eval": "npm run eval:live --prefix apps --",
    "eval:gate": "npm run eval:gate --prefix apps",
    "eval:live": "npm run eval:live --prefix apps --",
    "qa:report": "python3 scripts/qa/qa_report.py",
    "qa:contracts": "npm run eval:gate",
    "qa:smoke": "python3 scripts/qa/qa_smoke.py",
    "qa:replay": "python3 scripts/qa/qa_replay.py",
    "qa:suite": "python3 scripts/qa/qa_suite.py",
    "qa:gate": "python3 -m unittest scripts.qa.qa_report_test scripts.qa.qa_report_shannon_test -v && npm run qa:contracts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
