{
  "buildCommand": "npm run build -w @rhg/core && npm --prefix mvp install && npm --prefix mvp run build",
  "outputDirectory": "mvp/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/health.json"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gun.yishuziyu.cn/api/:path*"
    },
    {
      "source": "/((?!api/|.*\\..+$).*)",
      "destination": "/index.html"
    }
  ]
}
